# Copy to .env and edit.

# Pin this. Check https://github.com/immich-app/immich/releases before bumping.
IMMICH_VERSION=v3.2.2

# Immich's own storage. Must be a DIFFERENT tree from PhotoVault's primary.
UPLOAD_LOCATION=/Volumes/Photos/immich
DB_DATA_LOCATION=/Volumes/Photos/immich-db

DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
