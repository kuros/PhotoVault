# Copy to .env and edit.

# Pin this. Check https://github.com/immich-app/immich/releases before bumping.
IMMICH_VERSION=v3.2.2

# Timezone for the containers. /etc/localtime is not bind-mounted:
# it is a file under Docker Desktop but an empty directory in Colima's VM.
TZ=UTC

# Immich's own storage: thumbnails, and photos uploaded from your phone.
# Must be a DIFFERENT tree from PhotoVault's library.
# Keep these on an always-available disk - Immich cannot start without its
# database, so do not put DB_DATA_LOCATION on a drive you unplug.
UPLOAD_LOCATION=/Users/YOU/PhotoVault-immich/upload
# The database lives in a named Docker volume (immich-db), not here - see the
# comment in docker-compose.yml. Nothing to set.

# Your existing PhotoVault library, indexed read-only. Nothing is copied.
PHOTOVAULT_LIBRARY=/Users/YOU/PhotoVault/library

DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
